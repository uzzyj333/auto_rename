# Docker 环境变量示例
# 用法：cp .env.example .env 后按需修改
# 说明：只需要 ./data 一个持久化目录（config.ini / 日志 / 数据库都在里面），
#       日志与数据库在容器内的路径已内置，无需再映射宿主机日志路径。

# 时区
TZ=Asia/Shanghai

# Python 输出不缓冲
PYTHONUNBUFFERED=1

# Web 服务端口（宿主机端口，容器内固定 8080）
WEB_PORT=8080

# 挂载路径（相对路径以 docker-compose.yml 所在目录为基准）
# 数据目录 —— 唯一需要持久化的目录（配置 / 日志 / SQLite 数据库）
DATA_PATH=./data
# 下载目录（映射到容器内 /downloads）
DOWNLOADS_PATH=./downloads
# 媒体库目录（映射到容器内 /media，作为「在线识别上传」的视频根目录）
MEDIA_PATH=./media

# ===== 以下一般不需要修改 =====
# 日志目录（容器内路径），已在 docker-compose.yml 内置为 /app/data/logs
VIDEO_ORGANIZER_LOG_DIR=/app/data/logs
# 数据库文件（容器内路径），放在 data 卷内
VIDEO_ORGANIZER_DB_PATH=/app/data/video_organizer.db
